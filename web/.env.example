# ============================================
# Jogos Escolares - Frontend
# ============================================
# Copie para .env e preencha conforme o ambiente

# --- vite.config.js server.proxy (dev) e URLs diretas (build de produção) ---
# Local (padrão do projeto): use as mesmas portas do docker-compose em api-jels/.env
# VITE_API_SERVICE_URL=http://localhost:8000
# VITE_POSTGREST_URL=http://localhost:3001
# VITE_MINIO_URL=http://localhost:9000
# Remoto (deploy): defina no build ou use web/.env.production (Vite carrega automaticamente em `npm run build`).
# Paço do Lumiar:
# VITE_API_SERVICE_URL=https://auth-jels.pacodolumiar.ma.gov.br
# VITE_POSTGREST_URL=https://api-jels.pacodolumiar.ma.gov.br
# VITE_MINIO_URL=https://storage-jels.pacodolumiar.ma.gov.br
# Criative (exemplo):
# VITE_API_SERVICE_URL=https://auth-jels.criativesoftware.com.br
# VITE_POSTGREST_URL=https://api-jels.criativesoftware.com.br
# VITE_MINIO_URL=https://storage-jels.criativesoftware.com.br
# Se vazio no build, em produção o host jels.* infere auth-jels.* / api-jels.* / storage-jels.* automaticamente.
VITE_API_SERVICE_URL=
VITE_POSTGREST_URL=
VITE_MINIO_URL=
