# ============================================
# Jogos Escolares - API Service
# ============================================
# Copie para .env e preencha os valores

# Database
# Local (host acessível do PC; porta = POSTGRES_PORT do docker-compose, geralmente 5432):
# DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@127.0.0.1:5432/NOME_DO_BANCO
# Dentro do Docker, o compose define DATABASE_URL apontando para o serviço "postgres".
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# JWT (mínimo 32 caracteres em produção)
JWT_SECRET=
JWT_AUD=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# PostgREST
POSTGREST_PORT=

# Auth Service
AUTH_SERVICE_PORT=

# MinIO
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=
MINIO_CONSOLE_PORT=
MINIO_BROWSER_REDIRECT_URL=
MINIO_USE_SSL=

# CORS (origens permitidas, separadas por vírgula)
CORS_ORIGINS=

# Instagram API
INSTAGRAM_ACCESS_TOKEN=
VITE_INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_REFRESH_SECRET=